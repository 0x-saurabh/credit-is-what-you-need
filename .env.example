# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# The public address shown in docs, snippets and links (build-time).
# Defaults to https://usekredit.space.
NEXT_PUBLIC_SITE_URL=

# Sign-in is Privy (https://dashboard.privy.io): an email code or Google.
# Enable those two login methods and turn embedded wallets OFF. The app id is
# public and read when the site is built, so rebuild after changing it; the
# secret stays on the server and verifies logins.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Where everything is stored: users, credits, purchases, keys, sessions. A Neon
# Postgres connection string (Neon console → Connect → pooled URL). The tables
# are created on first use. Read only on the server (src/lib/db.ts); never
# expose it to client-side code.
DATABASE_URL=

# The AI provider behind /v1. Vercel AI Gateway is the default: one key reaches
# every maker, and its public model list carries the prices calls are billed
# from. OpenRouter works too. Without a key, only the test model "kredit/echo" works.
UPSTREAM_BASE_URL=https://ai-gateway.vercel.sh/v1
UPSTREAM_API_KEY=

# Optional: a second provider. With an OpenRouter key, its models are offered
# next to the ones above (a model on both is served by the one above).
OPENROUTER_API_KEY=

# Buying credits goes through Dodo Payments (merchant of record: cards, UPI and
# local methods worldwide, taxes handled). Buying is off until both keys are set.
# 1. API key: Dodo dashboard > Developer > API keys (test and live are separate).
# 2. Webhook: register <site>/api/payments/dodo/webhook for payment.succeeded and
#    refund.succeeded, and copy the endpoint secret here.
# 3. Products: `node scripts/dodo-products.mjs` makes one product per credit
#    pack at the price below; the server reads the packs back from Dodo.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode    # or live_mode
# Packs are sold in rupees. What a thousand credits cost, in paise, when the
# products are made (8500 = ₹85). The site shows model prices in rupees too, at
# NEXT_PUBLIC_INR_PER_USD rupees to the dollar (default 85, read at build time).
CREDITS_CURRENCY=INR
CREDITS_PRICE_INR_PER_1000=8500
NEXT_PUBLIC_INR_PER_USD=85

# Razorpay (INR; UPI, cards, net banking) is planned as a second provider; see
# docs/payments.md. Nothing reads these yet.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
